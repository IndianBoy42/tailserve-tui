{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2024"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Node runs these sources directly: type stripping, no build step. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "test"]
}
